{
  "rules": {
    ".read": false,
    ".write": false,

    "participants": {
      ".read": "auth != null",
      "$pid": {
        ".write": "auth != null && root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val()",

        "claimedBy": {
          ".write": "auth != null && (root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val() || ((!root.child('seatAuth').child($pid).child('passHash').exists() || root.child('seatAuth').child($pid).child('authorized').child(auth.uid).val() === root.child('seatAuth').child($pid).child('passHash').val()) && newData.val() === auth.uid))"
        }
      }
    },

    "seatAuth": {
      "$pid": {
        "passHash": {
          ".read": false,
          ".write": "auth != null && (!data.exists() || root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val())",
          ".validate": "!newData.exists() || newData.isString()"
        },
        "authorized": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('seatAuth').child($pid).child('passHash').exists() && newData.val() === root.child('seatAuth').child($pid).child('passHash').val()))"
          }
        }
      }
    },

    "weeks": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val()"
    },

    "picks": {
      ".read": "auth != null",
      "$week": {
        "$pid": {
          ".write": "auth != null && (root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val() || (root.child('seatAuth').child($pid).child('passHash').exists() && root.child('seatAuth').child($pid).child('authorized').child(auth.uid).val() === root.child('seatAuth').child($pid).child('passHash').val() && (!root.child('weeks').child($week).child('lockTime').exists() || now < root.child('weeks').child($week).child('lockTime').val())))"
        }
      }
    },

    "views": {
      ".read": "auth != null && root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val()",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "presence": {
      ".read": "auth != null && root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val()",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val()"
    },

    "admin": {
      "passHash": {
        ".read": false,
        ".write": "auth != null && root.child('admin/authorized').child(auth.uid).val() === root.child('admin/passHash').val()"
      },
      "authorized": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('admin/passHash').val()"
        }
      }
    }
  }
}
